# Normalise line endings — force LF in the repository for all text files
* text=auto eol=lf

# Explicit binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pbf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary
*.keystore binary
*.jks binary

# Unity-like generated/proto files are not used here; keep diffs clean for common formats
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.xml text eol=lf

# Mark batch/shell scripts executable-friendly (no CRLF issues)
*.sh text eol=lf
*.bat text eol=crlf
